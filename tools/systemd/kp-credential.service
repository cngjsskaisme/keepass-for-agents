# kp-credential.service — systemd unit for the Credential Service (Hardened Mode).
#
# This is the SYSTEM-level skeleton the docs refer to. tools/setup-hardened.sh
# generates the installed unit from this shape — the placeholders below are
# filled with real values at provisioning time:
#   __SERVICE_USER__    dedicated OS account (e.g. kpa-svc)
#   __AGENT_GROUP__     group of principals allowed to call the service
#   __CONFIG_PATH__     operator's config.toml (KEEPASS_AGENT_CONFIG)
#   __STATE_DIR__       service state dir (socket/token live there)
#   __NODE__            absolute path to the node binary
#   __REPO__            keepass-agent repo root
#   __KDBX_DIRS__       ReadWritePaths entries covering every KDBX dir
#
# Install manually if not using setup-hardened.sh:
#   cp this file → /etc/systemd/system/kp-credential.service (placeholders
#   substituted), then: systemctl daemon-reload && systemctl enable --now kp-credential

[Unit]
Description=keepass-agent credential service (Hardened Mode)
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__AGENT_GROUP__
Environment=KEEPASS_AGENT_CONFIG=__CONFIG_PATH__
# The service HOME supplies the isolated session store — point it at the
# service-owned state dir so sessions are unreadable by agent principals.
Environment=HOME=__STATE_DIR__/home
ExecStart=__NODE__ __REPO__/src/service/service.ts
Restart=on-failure
RestartSec=2

# --- sandboxing (recommended; keep ReadWritePaths in sync with config) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=__STATE_DIR__ __KDBX_DIRS__

[Install]
WantedBy=multi-user.target
